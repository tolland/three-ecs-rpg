// tsconfig.base.json
{
  "compilerOptions": {
    // Common settings
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    // Enable experimental decorators and metadata
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Define baseUrl and paths here if used consistently
    // Sets a base directory from which to resolve bare specifier module names. For example, in the directory structure:
    // <https://www.typescriptlang.org/tsconfig/#baseUrl>
    "baseUrl": "./src",
    "paths": {
      "@main/*": [
        "main/*"
      ],
      "@preload/*": [
        "preload/*"
      ],
      "@renderer/*": [
        "renderer/*"
      ],
      "@ecs/*": [
        "renderer/ecs/*"
      ],
      "@components/*": [
        "renderer/ecs/components/*"
      ],
      "@systems/*": [
        "renderer/ecs/systems/*"
      ],
      "@core/*": [
        "renderer/core/*"
      ],
      "@setup/*": [
        "renderer/setup/*"
      ],
      "@assets/*": [
        "assets/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@devinspectx/*": [
        "devinspectx/*"
      ],
      "@bridge/*": [
        "devinspectx/extension/bridge/*"
      ],
      "@panel/*": [
        "devinspectx/extension/panel/*"
      ],
      "@dev_tools/*": [
        "devinspectx/extension/dev_tools/*"
      ],
      "@ext-bg/*": [
        "devinspectx/extension/service_worker/*"
      ],
      "@ext-cs/*": [
        "devinspectx/extension/content_script/*"
      ]
    }
  }
}
