{
  "manifest_version": 3,
  "name": "Three.js ECS DevTools",
  "version": "1.0.0",
  "description": "Developer tools for Three.js ECS applications",
  "devtools_page": "devtools/devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
