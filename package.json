{
  "name": "three-ecs-rpg",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "rimraf dist && rollup -c",
    "watch": "rollup -c -w --bundleConfigAsCjs",
    "dev": "concurrently \"npm:watch\" \"electron . --inspect\"",
    "lint": "tsc --noEmit",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.yourcompany.threeecsrpg",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dat.gui": "^0.7.9",
    "dbus-next": "^0.10.2",
    "electron": "^35.1.2",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/dat.gui": "^0.7.13",
    "@types/three": "^0.175.0",
    "concurrently": "^9.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "lil-gui": "^0.20.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.38.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.3"
  }
}
