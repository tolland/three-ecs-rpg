{
  "name": "three-ecs-rpg",
  "version": "1.0.0",
  "description": "A simple RPG game using Three.js and ECS architecture.",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "pnpm run build && electron .",
    "build": "rimraf dist && rollup -c --logLevel debug",
    "watch": "rollup -c -w",
    "dev": "NODE_ENV=development concurrently \"pnpm:watch\" \"electron . --inspect\"",
    "lint": "tsc --noEmit",
    "package": "pnpm run build && electron-builder",
    "format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "generate-python-types": "ts-node scripts/generate-pydantic-models.ts",
    "generate-json-schema": "ts-node --project ./tsconfig.json scripts/generate-json-schema.ts"
  },
  "build": {
    "appId": "com.yourcompany.threeecsrpg",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.4",
    "chart.js": "^4.4.8",
    "dbus-next": "^0.10.2",
    "electron-log": "^5.3.3",
    "lil-gui": "^0.20.0",
    "plotly.js": "^3.0.1",
    "plotly.js-dist": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "stats.js": "^0.17.0",
    "three": "^0.175.0",
    "three-mesh-bvh": "^0.9.0",
    "x11": "^2.3.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@jest/types": "^29.6.3",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/dat.gui": "^0.7.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/plotly.js": "^2.35.4",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/three": "^0.175.0",
    "chalk": "^5.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "electron-reload": "2.0.0-alpha.1",
    "electron-reloader": "^1.2.3",
    "electron-vite": "^3.1.0",
    "glob": "^11.0.1",
    "jest": "^29.7.0",
    "jest-config": "^29.7.0",
    "plotly.js-dist-min": "^3.0.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.39.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-copy-watch": "^0.0.1",
    "rollup-plugin-import-css": "^3.5.8",
    "stylelint": "^16.18.0",
    "stylelint-config-standard": "^37.0.0",
    "three-stdlib": "^2.35.15",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-json-schema": "^0.65.1",
    "vite": "^6.2.5"
  }
}
