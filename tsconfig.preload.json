{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",           // Output CJS for preload
    "target": "ES2020",             // Match main/renderer environment
    "outDir": "./dist/preload",
    "rootDir": "./src/preload",
    "lib": ["ESNext", "DOM"]        // Needs Node and potentially DOM access
  },
  "include": ["src/preload/**/*"]
}